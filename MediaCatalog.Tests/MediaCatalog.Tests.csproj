<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaCatalog.Core\MediaCatalog.Core.csproj" />
    <!--
      The example plugin, so its DLL lands beside the tests and the plugin tests can load it
      the way the program does - off disk, through its own load context, by the shape of its
      methods. A plugin system tested only against a plugin written inside the test assembly
      is a plugin system tested against the one case that cannot go wrong.
    -->
    <ProjectReference Include="..\MediaCatalog.Plugins.EBooks\MediaCatalog.Plugins.EBooks.csproj" />
  </ItemGroup>

</Project>
