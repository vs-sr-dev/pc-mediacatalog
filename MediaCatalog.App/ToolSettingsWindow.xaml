<Window x:Class="MediaCatalog.App.ToolSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="External tools" Height="360" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="The advanced features need external tools. Easiest option: drop ffmpeg.exe, ffprobe.exe and fpcalc.exe into a 'tools' folder next to this application — they'll be found automatically. Otherwise set explicit paths here. Leave a box empty to auto-detect (PATH / common install folders)."/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="ffmpeg" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="FfmpegBox" Margin="4" VerticalContentAlignment="Center"/>
        <Button    Grid.Row="1" Grid.Column="2" Content="Browse…" Click="BrowseFfmpeg" Padding="8,2" Margin="4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="ffprobe" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="FfprobeBox" Margin="4" VerticalContentAlignment="Center"/>
        <Button    Grid.Row="2" Grid.Column="2" Content="Browse…" Click="BrowseFfprobe" Padding="8,2" Margin="4"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="fpcalc" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="FpcalcBox" Margin="4" VerticalContentAlignment="Center"/>
        <Button    Grid.Row="3" Grid.Column="2" Content="Browse…" Click="BrowseFpcalc" Padding="8,2" Margin="4"/>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="Downloads: FFmpeg → ffmpeg.org (gyan.dev builds) provides ffmpeg.exe + ffprobe.exe. Chromaprint → acoustid.org/chromaprint provides fpcalc.exe. Both are free and portable (just unzip)."/>

        <TextBlock Grid.Row="5" Grid.ColumnSpan="3" x:Name="StatusBox" VerticalAlignment="Bottom"
                   Margin="0,8" FontWeight="Bold"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Re-detect" Click="OnRedetect" Width="90" Margin="0,0,8,0"/>
            <Button Content="Save" Click="OnSave" Width="90" IsDefault="True" FontWeight="Bold"/>
            <Button Content="Cancel" Click="OnCancel" Width="90" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
