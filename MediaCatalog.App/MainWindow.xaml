<Window x:Class="MediaCatalog.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MediaCatalog.App"
        xmlns:vm="clr-namespace:MediaCatalog.App.ViewModels"
        mc:Ignorable="d"
        Title="Media Catalog" Height="680" Width="1160"
        Icon="Assets/MediaCatalog.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBarTray Grid.Row="0">
            <ToolBar>
                <Button Content="Scan…" Command="{Binding ScanCommand}" Padding="12,2" FontWeight="Bold"
                        ToolTip="Open the scan wizard: which drives and folders to walk, what to pick up, and whether to add to the catalogue or start again."/>
                <Button Content="Pause" Command="{Binding PauseCommand}" Padding="8,2"
                        ToolTip="Stop the scan but keep all progress; resume later."/>
                <Button Content="Resume" Command="{Binding ResumeCommand}" Padding="8,2"
                        ToolTip="Continue a previously paused scan from where it stopped."/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="8,2"
                        ToolTip="Stop the scan and discard the resumable session."/>
                <Separator/>
                <TextBlock Text="View:" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox ItemsSource="{Binding FilterModes}"
                          SelectedItem="{Binding SelectedFilter}"
                          Width="120" VerticalAlignment="Center"/>
                <Button x:Name="ScanFolderButton" Content="Scan folder…"
                        Click="OnScanFolderClick" Padding="8,2" IsEnabled="{Binding IsIdle}"
                        ToolTip="Add one folder to the catalogue without re-scanning whole drives."/>
                <Separator/>
                <Button x:Name="UndoButton" Content="Undo" Click="OnUndoClick" Padding="8,2"
                        IsEnabled="{Binding IsIdle}"
                        ToolTip="Reverse the last operation (up to ten are remembered)."/>
                <Separator/>
                <Button x:Name="RelocateButton" Content="Relocate…"
                        Click="OnRelocateClick" Padding="8,2" IsEnabled="{Binding IsIdle}"/>
                <CheckBox x:Name="DeleteOriginalCheck" Content="Delete after verify"
                          VerticalAlignment="Center" Margin="6,0"/>
                <Button x:Name="RenameButton" Content="Rename…"
                        Click="OnRenameClick" Padding="8,2" IsEnabled="{Binding IsIdle}"/>
                <Button x:Name="ConsolidateButton" Content="Consolidate…"
                        Click="OnConsolidateClick" Padding="8,2" IsEnabled="{Binding IsIdle}"
                        ToolTip="Move selected TV/films into the structured library folders."/>
                <Separator/>
                <Button x:Name="AnalyzeButton" Content="Fingerprint"
                        Click="OnAnalyzeClick" Padding="8,2" IsEnabled="{Binding IsIdle}"
                        ToolTip="Compute audio/video fingerprints to find the same content across encodings."/>
                <Button x:Name="DeepCheckButton" Content="Deep check"
                        Click="OnDeepCheckClick" Padding="8,2" IsEnabled="{Binding IsIdle}"
                        ToolTip="Fully decode files with FFmpeg to detect corruption (slow)."/>
                <Button x:Name="DeepCheckFolderButton" Content="Deep check folder…"
                        Click="OnDeepCheckFolderClick" Padding="8,2" IsEnabled="{Binding IsIdle}"
                        ToolTip="Deep check every media file in a folder and its subfolders, catalogued or not."/>
                <Button x:Name="VerifyTitlesButton" Content="Verify titles"
                        Click="OnVerifyTitlesClick" Padding="8,2" IsEnabled="{Binding IsIdle}"
                        ToolTip="Confirm film and programme titles, and fill in missing years, against the local IMDb data — falling back to TMDb only for what IMDb cannot answer."/>
                <Button x:Name="ValidateTvButton" Content="Validate TV (TMDb)"
                        Click="OnValidateTvClick" Padding="8,2" IsEnabled="{Binding IsIdle}"
                        ToolTip="Validate TV show names against themoviedb.org only."/>
                <Separator/>
                <!-- Pinned: these must never disappear into the toolbar's overflow arrow. -->
                <Button x:Name="SettingsButton" Content="Settings…" Click="OnSettingsClick" Padding="8,2"
                        ToolBar.OverflowMode="Never"/>
                <Button x:Name="AboutButton" Content="About" Click="OnAboutClick" Padding="8,2"
                        ToolBar.OverflowMode="Never" ToolTip="Version and credits."/>
            </ToolBar>
        </ToolBarTray>

        <!-- Filter bar -->
        <StackPanel Grid.Row="1" Margin="2,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="2,0"/>
                <ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding FilterColumn}"
                          Width="100" VerticalAlignment="Center" Margin="4,0"/>
                <CheckBox Content="not" IsChecked="{Binding FilterNegate}" VerticalAlignment="Center"
                          Margin="2,0" ToolTip="Exclude rows that match (e.g. Category not Audio)."/>
                <TextBox Text="{Binding FilterPattern, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         Width="280" VerticalAlignment="Center" Margin="4,0"
                         ToolTip="Wildcards: * = any characters, ? = one character. Plain text = contains."/>
                <Button Content="Add filter" Click="OnAddFilter" Padding="8,1" Margin="2,0" VerticalAlignment="Center"
                        ToolTip="Stack this as an additional filter (multiple filters per column allowed)."/>
                <Button Content="Clear all" Click="OnClearFilter" Padding="8,1" Margin="2,0" VerticalAlignment="Center"/>
                <Separator/>
                <Button Content="Columns…" Click="OnColumnsClick" Padding="8,1" Margin="2,0" VerticalAlignment="Center"/>
                <Button Content="Suggest consolidation…" Click="OnSuggestConsolidationClick" Padding="8,1" Margin="2,0"
                        VerticalAlignment="Center" IsEnabled="{Binding IsIdle}"/>
                <Button x:Name="RefreshCatalogButton" Content="Refresh catalogue" Click="OnRefreshCatalogClick"
                        Padding="8,1" Margin="2,0" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}"
                        ToolTip="Re-derive metadata for entries that predate the current features. Entries already up to date are skipped — nothing is re-scanned or re-hashed."/>
                <Button x:Name="RehashButton" Content="Re-hash pending" Click="OnRehashClick"
                        Padding="8,1" Margin="2,0" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}"
                        ToolTip="Re-hash files that were catalogued while they may still have been downloading."/>
                <Button Content="Missing files…" Click="OnMissingFilesClick" Padding="8,1" Margin="8,0"
                        VerticalAlignment="Center" Visibility="{Binding HasMissingFiles, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Unhashed files…" Click="OnUnhashedFilesClick" Padding="8,1" Margin="2,0"
                        VerticalAlignment="Center" IsEnabled="{Binding IsIdle}"
                        Visibility="{Binding HasUnhashedFiles, Converter={StaticResource BoolToVis}}"
                        ToolTip="Files the scan could not read to hash. Without a hash they are invisible to duplicate detection."/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding ActiveFilters}" Margin="40,4,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Display}" Click="OnRemoveFilter" Margin="0,0,6,0" Padding="6,1"
                                ToolTip="Click to remove this filter."/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Body: the results grid has the window to itself. Choosing what to scan lives
             in the scan wizard, where there is room to explain the options. -->
        <Grid Grid.Row="2" Margin="0,4">
            <DataGrid x:Name="FilesGrid"
                      ItemsSource="{Binding Files}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      CanUserSortColumns="True" CanUserResizeColumns="True" EnableRowVirtualization="True"
                      HorizontalScrollBarVisibility="Auto" ColumnWidth="SizeToHeader"
                      MouseDoubleClick="OnGridDoubleClick" PreviewKeyDown="OnGridKeyDown">
                <!-- The header right-click menu is built in code: handlers written inside a
                     Style setter are compiled into class handlers on the menu itself. -->
                <DataGrid.ContextMenu>
                    <ContextMenu Opened="OnContextMenuOpened">
                        <MenuItem Header="Open file" Click="OnOpenFile"/>
                        <MenuItem Header="Open containing folder" Click="OnOpenFolder"/>
                        <MenuItem Header="Move to folder…" Click="OnMoveToFolder"/>
                        <MenuItem Header="Remove from results (keeps file on disk)" Click="OnRemoveFromResults"/>
                        <MenuItem Header="Delete file(s) from disk…" Click="OnDeleteFiles"/>
                        <Separator/>
                        <MenuItem Header="Edit details…" Click="OnEditDetails"
                                  ToolTip="Every field at once — title, year, season, episode, category, name, date, integrity and kind."/>
                        <MenuItem Header="Edit title…" Click="OnEditTitle"/>
                        <MenuItem Header="Set title for this folder…" Click="OnSetTitleFolder"/>
                        <MenuItem Header="Edit season / episode…" Click="OnEditSeasonEpisode"/>
                        <MenuItem Header="Rename file…" Click="OnRenameFile"/>
                        <MenuItem Header="Set category" x:Name="CategoryMenu"/>
                        <MenuItem Header="Set category for this folder…" Click="OnSetCategoryFolder"/>
                        <MenuItem Header="Add new category…" Click="OnAddCategory"/>
                        <Separator/>
                        <MenuItem Header="Show duplicates of this file…" Click="OnShowDuplicates"/>
                        <MenuItem Header="Consolidate selected…" Click="OnConsolidateClick"/>
                        <MenuItem Header="Validate TV name (TMDb)" Click="OnValidateTvSelected"/>
                        <Separator/>
                        <MenuItem Header="Exclude this folder from results…" Click="OnExcludeFolder"/>
                        <MenuItem Header="Ignore this file type (removes + skips future scans)" Click="OnIgnoreExtension"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <!-- Every header carries a tooltip; the column-header style built in code
                     binds each header's ToolTip to its column's ToolTipService.ToolTip. -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Dup" Binding="{Binding DuplicateFlag}" Width="46"
                                        ToolTipService.ToolTip="DUP = byte-for-byte identical to another catalogued file. ~dup = the same content in a different encoding, matched by audio/video fingerprint. Blank = no known copy. Files that have no hash yet cannot be compared at all."/>
                    <DataGridTextColumn Header="Name" Binding="{Binding FileName}" Width="260"
                                        ToolTipService.ToolTip="The file's name on disk, without its folder. Rename it with the right-click menu."/>
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="55"
                                        ToolTipService.ToolTip="Audio or Video, decided by the file extension. Unknown means the extension is neither."/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"
                                        ToolTipService.ToolTip="What the content is: Movie, TvShow, TvExtra or MovieExtra (specials and featurettes), Audio, Other or Unknown. Worked out automatically unless you have set it yourself, which always wins."/>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="200"
                                        ToolTipService.ToolTip="The programme or film name. A confirmed or hand-typed title if there is one, otherwise the best guess parsed from the file name and its folders. This is what decides where the file is consolidated to."/>
                    <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="46"
                                        ToolTipService.ToolTip="Year of release, taken from the file name or looked up in the IMDb data. Part of a film's library folder name, e.g. 'Blade Runner (1982)'."/>
                    <DataGridTextColumn Header="S/E" Binding="{Binding SeasonEpisode}" Width="56"
                                        ToolTipService.ToolTip="Season and episode, as S01E02. Read from the file name (S01E02, 1x02, 123 = S01E23, 1102 = S11E02); a 'Season NN' folder supplies the season only when the name does not state one, so the file name always wins. Blank means it could not be worked out — a catalogue refresh will try again with the current rules."/>
                    <DataGridTextColumn Header="TMDb" Binding="{Binding TmdbFlag}" Width="46"
                                        ToolTipService.ToolTip="Where the title came from. ✓ = confirmed against the local IMDb data or TMDb. ✎ = you typed it. Blank = still only a guess from the file name, and a candidate for the next Verify titles run."/>
                    <DataGridTextColumn Header="Filed" Binding="{Binding FiledFlag}" Width="46"
                                        SortMemberPath="Model.Consolidated"
                                        ToolTipService.ToolTip="Ticked once the file is in its consolidation location — the structured library folder its category points at."/>
                    <!-- Sorted on the raw byte count, so 900 MB comes before 1.2 GB. -->
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="80"
                                        SortMemberPath="SizeBytes"
                                        ToolTipService.ToolTip="File size on disk. Sorted by the real byte count, so 900 MB comes before 1.2 GB."/>
                    <DataGridTextColumn Header="Integrity" Binding="{Binding Integrity}" Width="110"
                                        ToolTipService.ToolTip="Ok = passed the checks run so far. IncompleteDownload = a .part/.crdownload-style file still arriving. Corrupt = zero bytes, or a deep check failed to decode it. NotChecked = no deep check has been run on it."/>
                    <DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="380"
                                        ToolTipService.ToolTip="Where the file is now, in full. The folders here are also read for the programme name and season number when the file name alone does not say."/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding SummaryText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding ToolStatus}" Foreground="DimGray"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="180" Height="16"
                                 Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"/>
                    <TextBlock Text="{Binding EtaText}" Margin="6,0,0,0" MinWidth="90"
                               VerticalAlignment="Center" Foreground="DimGray"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
